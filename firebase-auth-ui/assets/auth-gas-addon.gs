/**
 * Inside the existing 'user_signup' branch, for the email/password path
 * (i.e. where the base Code.gs currently just calls sendWelcomeEmailToUser
 * unconditionally), branch on method instead:
 *
 *   if (details.method === 'email') {
 *     // VARIANT A:
 *     const token = generateVerificationToken();
 *     const expiresAt = new Date(Date.now() + VERIFICATION_EXPIRY_MS);
 *     const sheet = getVerificationSheet();
 *     sheet.insertRowBefore(2);
 *     sheet.getRange(2,1,1,6).setValues([[new Date(), details.email, token, details.uid || '', expiresAt, 'Pending']]);
 *     sendVerificationEmail(details.email, token);
 *
 *     // VARIANT B (use this block instead of the above):
 *     const code = generateVerificationCode();
 *     const expiresAt = new Date(Date.now() + VERIFICATION_EXPIRY_MS);
 *     const sheet = getVerificationSheet();
 *     sheet.insertRowBefore(2);
 *     sheet.getRange(2,1,1,6).setValues([[new Date(), details.email, code, details.uid || '', expiresAt, 'Pending']]);
 *     sendVerificationCodeEmail(details.email, code);
 *   } else {
 *     // Google sign-in — already verified, send welcome immediately
 *     sendWelcomeEmailToUser(details);
 *   }
 *   // Admin notification still fires either way (sendSignupNotificationEmail).
 */

/** VARIANT A — add this as a new action branch in doPost. */
function handleVerifyEmailAction(body) {
  const { token, email, uid } = body;
  if (!token || !email || !uid) {
    return jsonResponse({ success: false, error: "Missing token, email, or uid." });
  }
  return verifyAgainstSheet(email, uid, token);
}

/** VARIANT B — add this as a new action branch (action: 'verify_email_code'). */
function handleVerifyEmailCodeAction(body) {
  const { email, uid, code } = body;
  if (!email || !uid || !code) {
    return jsonResponse({ success: false, error: "Missing email, uid, or code." });
  }
  return verifyAgainstSheet(email, uid, code);
}

/** VARIANT B — add this as a new action branch (action: 'resend_verification_code'). */
function handleResendVerificationCodeAction(body) {
  const { email, uid } = body;
  if (!email || !uid) {
    return jsonResponse({ success: false, error: "Missing email or uid." });
  }
  const code = generateVerificationCode();
  const expiresAt = new Date(Date.now() + VERIFICATION_EXPIRY_MS);
  const sheet = getVerificationSheet();
  sheet.insertRowBefore(2);
  sheet.getRange(2, 1, 1, 6).setValues([[new Date(), email, code, uid, expiresAt, 'Pending']]);
  try {
    sendVerificationCodeEmail(email, code);
  } catch (mailErr) {
    console.error("[Resend] Email failed:", mailErr.toString());
    return jsonResponse({ success: false, error: "Could not resend the code. Try again shortly." });
  }
  return jsonResponse({ success: true, message: "A new code has been sent." });
}

/** Shared by both variants — matches the stored token/code, marks verified. */
function verifyAgainstSheet(email, uid, tokenOrCode) {
  try {
    const sheet = getVerificationSheet();
    const data = sheet.getDataRange().getValues();
    let found = false;
    let rowIndex = -1;

    for (let i = 1; i < data.length; i++) {
      const rowEmail = data[i][1];
      const rowValue = data[i][2] ? data[i][2].toString() : '';
      const rowStatus = data[i][5];
      const rowExpiry = new Date(data[i][4]);

      if (rowEmail === email && rowValue === tokenOrCode && rowStatus === 'Pending') {
        if (rowExpiry > new Date()) {
          found = true;
          rowIndex = i + 1;
        } else {
          return jsonResponse({ success: false, error: "This code/link has expired. Please sign up again or request a new code." });
        }
        break;
      }
    }

    if (!found) {
      return jsonResponse({ success: false, error: "Incorrect or already-used code/link." });
    }

    sheet.getRange(rowIndex, 6).setValue('Verified');

    try {
      updateFirestoreUserVerified(uid, true);
    } catch (fsErr) {
      console.error("[Verify] Firestore update failed:", fsErr.toString());
      return jsonResponse({ success: false, error: "Verified in system but profile update failed. Contact support." });
    }

    try {
      sendWelcomeEmailToUser({ email: email });
    } catch (wErr) {
      console.error("[Verify] Welcome email failed:", wErr.toString());
    }

    return jsonResponse({ success: true, message: "Email verified successfully." });
  } catch (err) {
    console.error("[Verify] Global error:", err.toString());
    return jsonResponse({ success: false, error: "Verification failed. Please try again." });
  }
}
