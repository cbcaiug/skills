/** VARIANT A — sends the tokenized verification link. */
function sendVerificationEmail(email, token) {
  const verifyUrl = `${APP_URL}/verify?token=${encodeURIComponent(token)}&email=${encodeURIComponent(email)}`;
  const body = `
    <p style="margin-top:0;">Hello,</p>
    <p>An account was created for <strong>${email}</strong> on ${APP_NAME}.
       Complete the sign-up by verifying this email address.</p>
    <div style="background:#f9fafb;border-left:4px solid ${PRIMARY_COLOR};
                padding:16px 20px;border-radius:6px;margin:24px 0;">
      <p style="margin:0;font-size:13px;color:#6b7280;">This link expires in <strong>24 hours</strong>
         and is only valid for this email address.</p>
    </div>
    ${getCtaButton('✅ Verify My Email', verifyUrl)}
    <p style="font-size:13px;color:#6b7280;margin-top:0;">
      If the button doesn't work, copy and paste this link into your browser:<br>
      <a href="${verifyUrl}" style="color:#3b82f6;word-break:break-all;">${verifyUrl}</a>
    </p>
    <p style="font-size:13px;color:#9ca3af;">
      If you didn't create an account on ${APP_NAME}, you can safely ignore this email.
    </p>`;

  MailApp.sendEmail({
    to: email,
    subject: `Verify your ${APP_NAME} account`,
    htmlBody: emailShell("Confirm your email address", body),
    name: `${APP_NAME} Security`
  });
}

/** VARIANT B — sends the 6-digit code. */
function sendVerificationCodeEmail(email, code) {
  const body = `
    <p style="margin-top:0;">Hello,</p>
    <p>An account was created for <strong>${email}</strong> on ${APP_NAME}.
       Enter this code to activate it:</p>
