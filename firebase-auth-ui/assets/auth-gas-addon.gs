const VERIFICATIONS_SHEET = "Verifications";
const VERIFICATION_EXPIRY_MS = 24 * 60 * 60 * 1000; // 24 hours — applies to both variants

// =============================================================
// TOKEN / CODE GENERATION
// =============================================================

/** VARIANT A — cryptographically random 64-char token for the link. */
function generateVerificationToken() {
  const bytes = Utilities.computeHmacSha256Signature(Utilities.getUuid(), Utilities.getUuid());
  return bytes.map(b => ('0' + (b & 0xFF).toString(16)).slice(-2)).join('').substring(0, 64);
}

/** VARIANT B — random 6-digit code. */
function generateVerificationCode() {
  return String(Math.floor(100000 + Math.random() * 900000));
}

// =============================================================
// VERIFICATIONS SHEET
// Columns: Timestamp | Email | Token/Code | UID | ExpiresAt | Status
// =============================================================

function getVerificationSheet() {
  return getLogSheet(VERIFICATIONS_SHEET,
    ['Timestamp', 'Email', 'Token', 'UID', 'ExpiresAt', 'Status']);
  // getLogSheet() is defined in the base Code.gs from gas-email-service.
}

// =============================================================
// FIRESTORE UPDATER
// =============================================================

/**
 * Sets `emailVerified` on /users/{uid} via the Firestore REST API.
 */
function updateFirestoreUserVerified(uid, isVerified) {
  const apiKey = PropertiesService.getScriptProperties().getProperty('FIREBASE_API_KEY');
  const url = `https://firestore.googleapis.com/v1/projects/${FIREBASE_PROJECT_ID}/databases/(default)/documents/users/${uid}?updateMask.fieldPaths=emailVerified&key=${apiKey}`;
  const options = {
    method: "patch",
    contentType: "application/json",
    payload: JSON.stringify({ fields: { emailVerified: { booleanValue: isVerified } } }),
    muteHttpExceptions: true
  };
  const res = UrlFetchApp.fetch(url, options);
  const data = JSON.parse(res.getContentText());
  if (res.getResponseCode() !== 200) {
    throw new Error("Firestore update failed: " + (data.error ? data.error.message : res.getContentText()));
  }
  return true;
}

