# ════════════════════════════════════════════════════════════════════════════
#  .env.local  — MUST live in the PROJECT ROOT (next to package.json + vite.config.js)
#  NOT in src/, NOT in a subfolder.  Vite only reads env files from the root.
#
#  RULES
#   1. Only variables starting with VITE_ reach the browser. Anything WITHOUT the
#      VITE_ prefix is invisible to the frontend (good) — but also useless to it.
#   2. VITE_ values are PUBLIC (anyone can read them in DevTools). NEVER put a MarzPay
#      secret, service-account key or Script Property here as VITE_.
#   3. After editing this file: STOP and RESTART `npm run dev`. Vite does not hot-reload env.
#   4. This file must be git-ignored (add `.env*` and keep `!.env.example` if you want).
#   5. On Vercel/hosting: add the same VITE_ names in the dashboard (Settings → Environment
#      Variables) and REDEPLOY — values are baked in at build time.
# ════════════════════════════════════════════════════════════════════════════

# ── A. PUBLIC (VITE_) — used by the browser ─────────────────────────────────

# Firebase console → ⚙ Project settings → General → "Your apps" → Web app → SDK setup and configuration → Config
VITE_FIREBASE_API_KEY=
# <project-id>.firebaseapp.com
VITE_FIREBASE_AUTH_DOMAIN=
# General tab → Project ID
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# optional (Analytics)
VITE_FIREBASE_MEASUREMENT_ID=

# Apps Script editor → Deploy → Manage deployments → Web app → URL. MUST end in /exec (not /dev)
VITE_GAS_BACKEND_URL=

# Cosmetic only (hides the Admin tab). The server enforces ADMIN_UIDS itself.
# Firebase console → Authentication → Users → "User UID" column (sign in once first)
VITE_ADMIN_UIDS=

# Payment modal behaviour (all optional)
# must also be in the server's ALLOWED_COUNTRIES
VITE_PAY_DEFAULT_COUNTRY=UG
# 1 = verbose [PayModal] console logs (still redacted)
VITE_PM_DEBUG=0

# ── B. SERVER-SIDE VALUES — NOT stored here ─────────────────────────────────
#  These go in Apps Script → Project Settings (⚙) → Script Properties → Edit script properties.
#  They are listed so you know what to collect; do not paste them into this file.
#
#   FIREBASE_PROJECT_ID     Firebase → Project settings → General → Project ID
#   FIREBASE_WEB_API_KEY    same page → Web API Key (same as VITE_FIREBASE_API_KEY)
#   MARZPAY_API_KEY         MarzPay dashboard → API Keys
#   MARZPAY_API_SECRET      MarzPay dashboard → API Keys   (shown once — store it safely)
#   WEBAPP_EXEC_URL         same URL as VITE_GAS_BACKEND_URL
#   WEBHOOK_TOKEN           make up a long random string (optional; enables webhooks)
#   ALLOWED_COUNTRIES       e.g. UG   (only countries you are subscribed to on MarzPay)
#   ADMIN_UIDS              your Firebase UID(s), comma-separated
#   APP_NAME                shown in the payment description
#   DEV_TEST_PHONE          your own mobile-money number — used by selfTestCollect()
#
# ── C. OPTIONAL: local Node test scripts only (scratch/*.mjs) ───────────────
#  Only if you run scripts from your own machine. Never prefix with VITE_.
# MARZPAY_API_BASE=https://wallet.wearemarz.com/api/v1
# MARZPAY_API_KEY=
# MARZPAY_API_SECRET=
