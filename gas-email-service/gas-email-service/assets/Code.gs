// =============================================================
// doPost HANDLER
// If this project already has a doPost, merge these action branches
// into it — do not create a second doPost or clobber existing actions.
// =============================================================

/**
 * Body schema:
 *   { action: 'user_signup',   details: { email, displayName, method } }
 *   { action: 'submit_report', details: { name, email, message, subject, type } }
 * Add one action branch per new event function.
 */
function doPost(e) {
  let body;
  try {
    body = JSON.parse(e.postData.contents);
  } catch (parseErr) {
    return jsonResponse({ success: false, error: "Invalid JSON body." });
  }

  const action = body.action;

  if (action === 'user_signup') {
    const details = body.details || {};
    try {
      try { sendWelcomeEmailToUser(details); }
      catch (wErr) { console.error("[Signup] Welcome email failed:", wErr.toString()); }

      try { sendSignupNotificationEmail(details); }
      catch (nErr) { console.error("[Signup] Admin notification failed:", nErr.toString()); }

      return jsonResponse({ success: true, message: "Signup processed." });
    } catch (err) {
      console.error("[Signup] Global error:", err.toString());
      return jsonResponse({ success: false, error: err.toString() });
    }
  }

  if (action === 'submit_report') {
    const details = body.details || {};
    try {
      sendReportNotificationToAdmin(details);
      try { sendReportReceivedAutoReply(details); }
      catch (replyErr) { console.error("[Report] Auto-reply failed:", replyErr.toString()); }
      return jsonResponse({ success: true, message: "Report received." });
    } catch (err) {
      console.error("[Report] Error:", err.toString());
      return jsonResponse({ success: false, error: "Failed to process report." });
    }
  }

  return jsonResponse({ success: false, error: `Unknown action: ${action}` });
}

/**
 * doGet — health check / ping
 */
function doGet(e) {
  if (e.parameter.action === 'ping') {
    return jsonResponse({ success: true, message: 'pong', app: APP_NAME });
  }
  return jsonResponse({ success: true, message: `${APP_NAME} GAS email backend is live.` });
}

/**
 * Shorthand: return JSON ContentService output
 */
function jsonResponse(obj) {
  return ContentService
    .createTextOutput(JSON.stringify(obj))
    .setMimeType(ContentService.MimeType.JSON);
}
