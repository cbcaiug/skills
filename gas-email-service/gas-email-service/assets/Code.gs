/**
 * REPORT / CONTACT RECEIVED — auto-reply sent to the submitter.
 */
function sendReportReceivedAutoReply(details) {
  const { name, email, message, subject: reportSubject } = details;
  if (!email) return;

  const greeting    = name ? `Hi ${name},` : 'Hello,';
  const preview     = message ? message.substring(0, 120) + (message.length > 120 ? '...' : '') : null;
  const previewHtml = preview ? `
    <div style="background:#f9fafb;border-left:4px solid ${PRIMARY_COLOR};
                padding:14px 18px;border-radius:6px;margin:20px 0;">
      <p style="margin:0;font-size:13px;color:#374151;font-style:italic;">"${preview}"</p>
    </div>` : '';

  const body = `
    <p style="margin-top:0;">${greeting}</p>
    <p>The message has been received. ${CREATOR_NAME} will review it and get back
       to you if a response is needed.</p>
    ${previewHtml}
    <p style="margin-top:28px;">
      ${CREATOR_NAME}<br>
      <span style="color:#9ca3af;font-size:13px;">${CREATOR_TITLE}, ${APP_NAME}</span>
    </p>`;

  MailApp.sendEmail({
    to:       email,
    subject:  `Message received ✅`,
    htmlBody: emailShell("Got your message", body),
    name:     `${APP_NAME} Support`,
    bcc:      ADMIN_EMAIL
  });
}

