/**
 * WELCOME EMAIL — sent to a new user.
 */
function sendWelcomeEmailToUser(details) {
  const { email, displayName } = details;
  if (!email) return;

  const greeting = displayName ? `Hi ${displayName},` : 'Hello,';
  const body = `
    <p style="margin-top:0;">${greeting} 👋</p>
    <p>Welcome to <strong>${APP_NAME}</strong>. ${APP_TAGLINE}</p>
    <p>The platform is built to be straightforward and practical.
       No bloat — just tools that work for you.</p>
    ${getCtaButton('🚀 Get Started', APP_URL)}
    <p>Got a question or running into an issue? Reach out below for the
       fastest response.</p>
    <p style="margin-top:28px;">
      ${CREATOR_NAME}<br>
      <span style="color:#9ca3af;font-size:13px;">${CREATOR_TITLE}, ${APP_NAME}</span>
    </p>`;

  MailApp.sendEmail({
    to:       email,
    subject:  `Welcome to ${APP_NAME}! 🎉`,
    htmlBody: emailShell(`Welcome aboard`, body),
    name:     `${CREATOR_NAME} (${APP_NAME})`
    // To also BCC the admin on this email, add: bcc: ADMIN_EMAIL
  });
}

