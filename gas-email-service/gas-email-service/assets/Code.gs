/**
 * Formats a Date to: Sat-25th-April-2026 at 6:09 PM (EAT)
 */
function formatCustomDate(d) {
  if (!d || isNaN(d.getTime())) return 'N/A';
  const days   = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
  const months = ['January','February','March','April','May','June',
                  'July','August','September','October','November','December'];
  const dayName   = days[d.getDay()];
  const dateNum   = d.getDate();
  const monthName = months[d.getMonth()];
  const year      = d.getFullYear();
  let hours       = d.getHours();
  const minutes   = d.getMinutes().toString().padStart(2, '0');
  const ampm      = hours >= 12 ? 'PM' : 'AM';
  hours           = hours % 12 || 12;
  const getOrdinal = n => {
    const s = ["th","st","nd","rd"], v = n % 100;
    return n + (s[(v-20) % 10] || s[v] || s[0]);
  };
  return `${dayName}-${getOrdinal(dateNum)}-${monthName}-${year} at ${hours}:${minutes} ${ampm}`;
}

/**
 * Returns (or creates) the log sheet. Any GAS function that wants a
 * durable record of an event (signups, reports, verification tokens, etc.)
 * should call this and append its own columns as needed — don't hardcode
 * a single fixed schema here, since the columns depend on which events
 * this project actually uses.
 */
function getLogSheet(sheetName, headerRow) {
  const props   = PropertiesService.getScriptProperties();
  const sheetId = props.getProperty('logSheetId');
  let ss;
  try {
    ss = sheetId ? SpreadsheetApp.openById(sheetId) : SpreadsheetApp.getActiveSpreadsheet();
  } catch (e) {
    ss = SpreadsheetApp.getActiveSpreadsheet();
  }
  if (!ss) throw new Error("Log Spreadsheet not found. Set 'logSheetId' in Script Properties.");

  let sheet = ss.getSheetByName(sheetName);
  if (!sheet) {
    sheet = ss.insertSheet(sheetName);
    if (headerRow && headerRow.length) {
      sheet.appendRow(headerRow);
      sheet.getRange(1, 1, 1, headerRow.length)
           .setBackground('#1f2937')
           .setFontColor('white')
           .setFontWeight('bold');
      sheet.setFrozenRows(1);
    }
  }
  return sheet;
}

